---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		title: 'Custom Software',
		description:
			'Focused web applications, internal tools, and customer portals built around the way your team actually works.',
	},
	{
		title: 'Automation Systems',
		description:
			'Workflow automation, integrations, reporting pipelines, and task reduction for operations that have outgrown manual handoffs.',
	},
	{
		title: 'Digital Infrastructure',
		description:
			'Cloud setup, deployment pipelines, data flows, and system architecture that give growing organizations room to move.',
	},
	{
		title: 'Technical Advisory',
		description:
			'Clear audits, modernization plans, and build-versus-buy guidance when the next technology decision needs sharper thinking.',
	},
];

const process = ['Map the operation', 'Design the system', 'Build in focused cycles', 'Measure and improve'];
---

<Layout>
	<header class="site-header" aria-label="Site header">
		<a class="brand" href="/" aria-label="Banta Technologies home">
			<span class="brand-mark" aria-hidden="true">BT</span>
			<span>Banta Technologies</span>
		</a>
		<nav aria-label="Primary navigation">
			<a href="#services">Services</a>
			<a href="#process">Process</a>
			<a href="#contact">Contact</a>
		</nav>
	</header>

	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-media" aria-hidden="true">
				<img
					src="/images/banta-hero.png"
					alt=""
					width="1536"
					height="864"
					fetchpriority="high"
				/>
			</div>
			<div class="hero-content">
				<p class="eyebrow">Software systems for practical growth</p>
				<h1 id="hero-title">Banta Technologies</h1>
				<p class="hero-copy">
					We build custom software, automation, and digital operations systems for teams that
					need their technology to work as hard as they do.
				</p>
				<div class="hero-actions" aria-label="Primary actions">
					<a class="button primary" href="#contact">Start a conversation</a>
					<a class="button secondary" href="#services">Explore services</a>
				</div>
			</div>
			<div class="hero-strip" aria-label="Company focus areas">
				<span>Operations software</span>
				<span>Automation</span>
				<span>Cloud systems</span>
				<span>Technical planning</span>
			</div>
		</section>

		<section class="intro">
			<div>
				<p class="section-kicker">What we solve</p>
				<h2>Technology should remove drag, not create another layer of work.</h2>
			</div>
			<p>
				Banta Technologies helps organizations turn scattered processes, aging tools, and manual
				workarounds into dependable systems. We favor clear architecture, direct communication,
				and software that earns its place inside the business.
			</p>
		</section>

		<section id="services" class="services" aria-labelledby="services-title">
			<div class="section-heading">
				<p class="section-kicker">Services</p>
				<h2 id="services-title">Built around the points where work slows down.</h2>
			</div>
			<div class="service-grid">
				{
					services.map((service) => (
						<article class="service-card">
							<h3>{service.title}</h3>
							<p>{service.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section id="process" class="process" aria-labelledby="process-title">
			<div class="section-heading">
				<p class="section-kicker">Process</p>
				<h2 id="process-title">A practical path from messy problem to working system.</h2>
			</div>
			<ol class="process-list">
				{
					process.map((step, index) => (
						<li>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<strong>{step}</strong>
						</li>
					))
				}
			</ol>
		</section>

		<section class="proof" aria-label="Working principles">
			<p>
				We work best with teams that value durable systems, short feedback loops, and technical
				decisions that can be explained without theater.
			</p>
		</section>

		<section id="contact" class="contact" aria-labelledby="contact-title">
			<div>
				<p class="section-kicker">Contact</p>
				<h2 id="contact-title">Bring the workflow, bottleneck, or build idea.</h2>
			</div>
			<div class="contact-panel">
				<p>
					Tell us what is slowing the business down and what better would look like. We will
					help shape the next useful step.
				</p>
				<a class="button primary" href="mailto:hello@bantatechnologies.com">
					hello@bantatechnologies.com
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.site-header {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 18px clamp(20px, 4vw, 56px);
		color: #f7f3ea;
		background: rgba(16, 24, 21, 0.62);
		border-bottom: 1px solid rgba(247, 243, 234, 0.14);
		backdrop-filter: blur(18px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		font-size: 0.95rem;
		font-weight: 760;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		color: #13211e;
		background: #d5a84f;
		border-radius: 6px;
		font-size: 0.76rem;
		font-weight: 850;
	}

	nav {
		display: flex;
		align-items: center;
		gap: clamp(14px, 3vw, 34px);
		font-size: 0.88rem;
		font-weight: 650;
	}

	nav a {
		color: rgba(247, 243, 234, 0.82);
		text-decoration: none;
	}

	nav a:hover {
		color: #ffffff;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: 92vh;
		padding: 150px clamp(20px, 6vw, 82px) 44px;
		overflow: hidden;
		color: #f8f3e9;
		background: #101815;
	}

	.hero-media,
	.hero-media::after {
		position: absolute;
		inset: 0;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.74;
	}

	.hero-media::after {
		content: "";
		background:
			linear-gradient(90deg, rgba(13, 21, 18, 0.96) 0%, rgba(13, 21, 18, 0.78) 42%, rgba(13, 21, 18, 0.2) 100%),
			linear-gradient(180deg, rgba(13, 21, 18, 0.3) 0%, rgba(13, 21, 18, 0.28) 62%, rgba(13, 21, 18, 0.86) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		align-self: center;
		max-width: 790px;
	}

	.eyebrow,
	.section-kicker {
		margin: 0 0 14px;
		color: #d5a84f;
		font-size: 0.78rem;
		font-weight: 820;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 780px;
		margin-bottom: 22px;
		font-size: clamp(3.6rem, 10vw, 8.6rem);
		line-height: 0.9;
		letter-spacing: 0;
	}

	h2 {
		color: #17201d;
		font-size: clamp(2rem, 4vw, 4rem);
		line-height: 1;
		letter-spacing: 0;
	}

	h3 {
		color: #18231f;
		font-size: 1.18rem;
	}

	p {
		color: #52615b;
		font-size: 1rem;
		line-height: 1.7;
	}

	.hero-copy {
		max-width: 620px;
		margin-bottom: 34px;
		color: rgba(248, 243, 233, 0.84);
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		line-height: 1.55;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 12px 18px;
		border: 1px solid transparent;
		border-radius: 6px;
		font-size: 0.94rem;
		font-weight: 780;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background-color 160ms ease,
			border-color 160ms ease;
	}

	.button:hover {
		transform: translateY(-1px);
	}

	.button.primary {
		color: #14201d;
		background: #d5a84f;
	}

	.button.secondary {
		color: #f8f3e9;
		border-color: rgba(248, 243, 233, 0.34);
		background: rgba(248, 243, 233, 0.08);
	}

	.hero-strip {
		position: relative;
		z-index: 1;
		align-self: end;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		width: min(100%, 940px);
		margin-top: 68px;
		border: 1px solid rgba(248, 243, 233, 0.18);
		background: rgba(248, 243, 233, 0.14);
	}

	.hero-strip span {
		padding: 15px 16px;
		color: rgba(248, 243, 233, 0.86);
		background: rgba(16, 24, 21, 0.68);
		font-size: 0.84rem;
		font-weight: 760;
		text-align: center;
	}

	.intro,
	.services,
	.process,
	.contact {
		padding: clamp(70px, 10vw, 132px) clamp(20px, 6vw, 82px);
	}

	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.92fr);
		gap: clamp(36px, 7vw, 96px);
		align-items: start;
		background: #f5f2eb;
	}

	.intro p:last-child {
		margin-bottom: 0;
		padding-top: 6px;
		font-size: 1.08rem;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1.1fr);
		gap: clamp(28px, 6vw, 82px);
		margin-bottom: 42px;
	}

	.services {
		background: #e8eee9;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
	}

	.service-card {
		min-height: 280px;
		padding: 26px;
		border: 1px solid #ccd8d0;
		border-radius: 8px;
		background: #fbfaf5;
	}

	.service-card h3 {
		margin-bottom: 18px;
	}

	.service-card p {
		margin-bottom: 0;
	}

	.process {
		background: #f5f2eb;
	}

	.process-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
		padding: 0;
		margin: 0;
		list-style: none;
		border-top: 1px solid #cfc7b6;
		border-left: 1px solid #cfc7b6;
	}

	.process-list li {
		display: grid;
		align-content: space-between;
		min-height: 190px;
		padding: 24px;
		border-right: 1px solid #cfc7b6;
		border-bottom: 1px solid #cfc7b6;
	}

	.process-list span {
		color: #0d6f6a;
		font-size: 0.86rem;
		font-weight: 820;
	}

	.process-list strong {
		color: #17201d;
		font-size: 1.28rem;
		line-height: 1.15;
	}

	.proof {
		padding: clamp(72px, 9vw, 118px) clamp(20px, 10vw, 140px);
		background: #0f1715;
	}

	.proof p {
		max-width: 1120px;
		margin: 0;
		color: #f8f3e9;
		font-size: clamp(1.9rem, 5vw, 5.1rem);
		line-height: 1.02;
	}

	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(320px, 520px);
		gap: clamp(32px, 7vw, 100px);
		background: #d9d0be;
	}

	.contact-panel {
		padding: 30px;
		border: 1px solid rgba(23, 32, 29, 0.16);
		border-radius: 8px;
		background: #f8f3e9;
	}

	.contact-panel p {
		margin-bottom: 24px;
	}

	.contact-panel .button {
		width: 100%;
	}

	@media (max-width: 980px) {
		.hero {
			min-height: 88vh;
			padding-top: 128px;
		}

		.hero-strip,
		.service-grid,
		.process-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.intro,
		.section-heading,
		.contact {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 680px) {
		.site-header {
			position: absolute;
			align-items: flex-start;
			padding: 16px 18px;
		}

		.brand span:last-child {
			display: none;
		}

		nav {
			gap: 12px;
			font-size: 0.78rem;
		}

		.hero {
			min-height: 90vh;
			padding: 112px 18px 28px;
		}

		.hero-media img {
			object-position: 64% center;
		}

		.hero-media::after {
			background:
				linear-gradient(90deg, rgba(13, 21, 18, 0.94) 0%, rgba(13, 21, 18, 0.78) 70%, rgba(13, 21, 18, 0.45) 100%),
				linear-gradient(180deg, rgba(13, 21, 18, 0.18) 0%, rgba(13, 21, 18, 0.34) 58%, rgba(13, 21, 18, 0.88) 100%);
		}

		h1 {
			font-size: clamp(3rem, 18vw, 5rem);
		}

		h2 {
			font-size: clamp(2rem, 11vw, 3rem);
		}

		.hero-actions,
		.hero-actions .button {
			width: 100%;
		}

		.hero-strip,
		.service-grid,
		.process-list {
			grid-template-columns: 1fr;
		}

		.hero-strip span {
			text-align: left;
		}

		.intro,
		.services,
		.process,
		.contact {
			padding: 66px 18px;
		}

		.service-card,
		.process-list li {
			min-height: auto;
		}

		.proof {
			padding: 64px 18px;
		}

		.contact-panel {
			padding: 22px;
		}
	}
</style>
