---
import Layout from '../layouts/Layout.astro';

const services = [
	{
		title: 'Website Development',
		description:
			'Static sites, Astro builds, GitHub Pages hosting, landing pages, and SEO-friendly content structure for organizations that need a clear, useful web presence.',
	},
	{
		title: 'Automation & Workflow Systems',
		description:
			'Forms, reports, reminders, email workflows, spreadsheet replacement, and data movement that remove repetitive work without hiding the process from the people who use it.',
	},
	{
		title: 'AI-Assisted Operations',
		description:
			'Practical prompt workflows, internal assistant concepts, image and model workflows, and safe AI experiments tied to real tasks, not novelty demos.',
	},
	{
		title: 'Cloud & Server Systems',
		description:
			'AWS, EC2, Linux servers, deployment scripts, GitHub Actions, OpenVPN, secure remote access, and monitoring basics for systems that need to stay reachable.',
	},
	{
		title: 'Custom Internal Tools',
		description:
			'Small web apps, dashboards, customer portals, admin tools, scripts, and operational utilities when an off-the-shelf tool does not fit the way the work actually happens.',
	},
	{
		title: 'Technology Advisory',
		description:
			'Plain-English technical planning, troubleshooting, modernization, vendor selection, and build-vs-buy guidance before money or time gets pointed in the wrong direction.',
	},
];

const helpers = [
	'Small businesses',
	'Nonprofits',
	'Local organizations',
	'Independent operators',
	'Community projects',
	'Teams outgrowing spreadsheets and manual processes',
];

const reasons = [
	{
		title: 'Real-world work comes first',
		description:
			'Before choosing tools, we look at the job, the people doing it, the constraints, and the scattered emails, paper steps, and handoffs that slow everything down.',
	},
	{
		title: 'Clear explanations',
		description:
			'You should understand what is being built, why it matters, and how to live with it after launch. No tech theater required.',
	},
	{
		title: 'Security-minded by default',
		description:
			'Remote access, cloud systems, servers, and automation are planned with sensible permissions, backups, and maintenance in mind.',
	},
];

const process = [
	{
		title: 'Understand the work',
		description:
			'We start with the real process: what happens now, what breaks, who touches it, and what better would look like.',
	},
	{
		title: 'Choose the practical path',
		description:
			'Sometimes the answer is a website. Sometimes it is automation, a server fix, a script, a dashboard, or better use of tools you already have.',
	},
	{
		title: 'Build in focused steps',
		description:
			'Useful pieces come first. The system grows through feedback instead of disappearing into a long, vague project.',
	},
	{
		title: 'Leave it understandable',
		description:
			'The goal is durable technology your organization can live with: documented, explainable, and ready for the next improvement.',
	},
];
---

<Layout>
	<header class="site-header" aria-label="Site header">
		<a class="brand" href="/" aria-label="Banta Technologies home">
			<span class="brand-mark" aria-hidden="true">BT</span>
			<span>Banta Technologies</span>
		</a>
		<nav aria-label="Primary navigation">
			<a href="#what-we-do">What We Do</a>
			<a href="#services">Services</a>
			<a href="#about">About</a>
			<a href="#contact">Contact</a>
		</nav>
	</header>

	<main>
		<section class="hero" aria-labelledby="hero-title">
			<div class="hero-media" aria-hidden="true">
				<img
					src="/images/banta-hero.png"
					alt=""
					width="1536"
					height="864"
					fetchpriority="high"
				/>
			</div>
			<div class="hero-content">
				<p class="eyebrow">Websites, automation, AI, cloud, and practical support</p>
				<h1 id="hero-title">Practical technology systems for real-world work</h1>
				<p class="hero-copy">
					Banta Technologies helps small businesses, nonprofits, and local organizations turn
					messy workflows, manual processes, and scattered tools into dependable websites,
					automation, cloud systems, and custom software.
				</p>
				<div class="hero-actions" aria-label="Primary actions">
					<a class="button primary" href="#contact">Start a conversation</a>
					<a class="button secondary" href="#services">See what we build</a>
				</div>
			</div>
			<div class="hero-strip" aria-label="Company focus areas">
				<span>Small business websites</span>
				<span>AI-assisted workflows</span>
				<span>AWS & Linux systems</span>
				<span>Automation that reduces busywork</span>
			</div>
		</section>

		<section id="what-we-do" class="intro">
			<div>
				<p class="section-kicker">What We Do</p>
				<h2>Technology should remove drag, not create another layer of work.</h2>
			</div>
			<div class="intro-copy">
				<p>
					Many organizations are stuck between two bad options: keep wrestling with scattered
					spreadsheets, emails, paper processes, and aging tools, or buy oversized software that
					creates a new kind of confusion.
				</p>
				<p>
					Banta Technologies works in the practical middle. We improve websites, automations,
					AI workflows, Linux servers, AWS setups, internal tools, and digital operations
					processes. Custom software is on the table when it is the right answer, but never just
					for software's sake.
				</p>
			</div>
		</section>

		<section id="services" class="services" aria-labelledby="services-title">
			<div class="section-heading">
				<p class="section-kicker">Services</p>
				<h2 id="services-title">Useful systems, sized for the actual problem.</h2>
			</div>
			<div class="service-grid">
				{
					services.map((service) => (
						<article class="service-card">
							<h3>{service.title}</h3>
							<p>{service.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section class="audience" aria-labelledby="audience-title">
			<div class="section-heading compact">
				<p class="section-kicker">Who We Help</p>
				<h2 id="audience-title">Built for working organizations with real constraints.</h2>
			</div>
			<ul class="audience-list" aria-label="Organizations Banta Technologies helps">
				{helpers.map((helper) => <li>{helper}</li>)}
			</ul>
		</section>

		<section class="why" aria-labelledby="why-title">
			<div class="section-heading">
				<p class="section-kicker">Why Banta Technologies</p>
				<h2 id="why-title">A practical technology partner, not a big-agency production.</h2>
			</div>
			<div class="reason-grid">
				{
					reasons.map((reason) => (
						<article>
							<h3>{reason.title}</h3>
							<p>{reason.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section id="process" class="process" aria-labelledby="process-title">
			<div class="section-heading">
				<p class="section-kicker">Process</p>
				<h2 id="process-title">Simple enough to follow. Strong enough to keep improving.</h2>
			</div>
			<ol class="process-list">
				{
					process.map((step, index) => (
						<li>
							<span>{String(index + 1).padStart(2, '0')}</span>
							<strong>{step.title}</strong>
							<p>{step.description}</p>
						</li>
					))
				}
			</ol>
		</section>

		<section id="about" class="about" aria-labelledby="about-title">
			<div>
				<p class="section-kicker">About Victor</p>
				<h2 id="about-title">Understand the work first. Then build what makes it easier.</h2>
			</div>
			<div class="about-panel">
				<p>
					Banta Technologies is led by Victor Banta, a practical technologist with experience
					across IT, cloud systems, automation, operations, nonprofit work, and hands-on systems
					building.
				</p>
				<p>
					His approach is simple: understand the work first, then build technology that makes
					the work easier. That may mean a website, a server fix, a script, an automation, a
					small internal tool, or a clearer plan for what not to build.
				</p>
				<p>
					The goal is useful technology that fits the people who will actually use it: durable,
					understandable, and maintainable after the first version goes live.
				</p>
			</div>
		</section>

		<section class="proof" aria-label="Working principle">
			<p>
				If your organization has outgrown spreadsheets, confusing tools, or manual processes,
				the next step does not have to be overwhelming.
			</p>
		</section>

		<section id="contact" class="contact" aria-labelledby="contact-title">
			<div>
				<p class="section-kicker">Contact</p>
				<h2 id="contact-title">Bring the website, workflow, server issue, or build idea.</h2>
			</div>
			<div class="contact-panel">
				<p>
					Send a short note about what is slowing you down and what you are trying to make
					better. We can talk through the practical next step.
				</p>
				<a class="button primary" href="mailto:hello@bantatechnologies.com">
					hello@bantatechnologies.com
				</a>
			</div>
		</section>
	</main>
</Layout>

<style>
	.site-header {
		position: fixed;
		z-index: 20;
		top: 0;
		left: 0;
		right: 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 18px clamp(20px, 4vw, 56px);
		color: #f7f3ea;
		background: rgba(16, 24, 21, 0.66);
		border-bottom: 1px solid rgba(247, 243, 234, 0.14);
		backdrop-filter: blur(18px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		flex: 0 0 auto;
		gap: 11px;
		font-size: 0.95rem;
		font-weight: 760;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		color: #13211e;
		background: #d5a84f;
		border-radius: 6px;
		font-size: 0.76rem;
		font-weight: 850;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(12px, 2.6vw, 32px);
		font-size: 0.86rem;
		font-weight: 650;
	}

	nav a {
		color: rgba(247, 243, 234, 0.82);
		text-decoration: none;
		white-space: nowrap;
	}

	nav a:hover {
		color: #ffffff;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: 94vh;
		padding: 150px clamp(20px, 6vw, 82px) 44px;
		overflow: hidden;
		color: #f8f3e9;
		background: #101815;
	}

	.hero-media,
	.hero-media::after {
		position: absolute;
		inset: 0;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.72;
	}

	.hero-media::after {
		content: "";
		background:
			linear-gradient(90deg, rgba(13, 21, 18, 0.96) 0%, rgba(13, 21, 18, 0.78) 48%, rgba(13, 21, 18, 0.24) 100%),
			linear-gradient(180deg, rgba(13, 21, 18, 0.28) 0%, rgba(13, 21, 18, 0.3) 62%, rgba(13, 21, 18, 0.86) 100%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		align-self: center;
		max-width: 890px;
	}

	.eyebrow,
	.section-kicker {
		margin: 0 0 14px;
		color: #d5a84f;
		font-size: 0.76rem;
		font-weight: 820;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		max-width: 920px;
		margin-bottom: 22px;
		font-size: clamp(3.2rem, 8vw, 7.7rem);
		line-height: 0.93;
		letter-spacing: 0;
	}

	h2 {
		color: #17201d;
		font-size: clamp(2rem, 4vw, 4rem);
		line-height: 1;
		letter-spacing: 0;
	}

	h3 {
		color: #18231f;
		font-size: 1.16rem;
		line-height: 1.18;
	}

	p {
		color: #52615b;
		font-size: 1rem;
		line-height: 1.7;
	}

	.hero-copy {
		max-width: 720px;
		margin-bottom: 34px;
		color: rgba(248, 243, 233, 0.86);
		font-size: clamp(1.08rem, 2vw, 1.35rem);
		line-height: 1.55;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 12px 18px;
		border: 1px solid transparent;
		border-radius: 6px;
		font-size: 0.94rem;
		font-weight: 780;
		text-decoration: none;
		transition:
			transform 160ms ease,
			background-color 160ms ease,
			border-color 160ms ease;
	}

	.button:hover {
		transform: translateY(-1px);
	}

	.button.primary {
		color: #14201d;
		background: #d5a84f;
	}

	.button.secondary {
		color: #f8f3e9;
		border-color: rgba(248, 243, 233, 0.34);
		background: rgba(248, 243, 233, 0.08);
	}

	.hero-strip {
		position: relative;
		z-index: 1;
		align-self: end;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		width: min(100%, 1100px);
		margin-top: 68px;
		border: 1px solid rgba(248, 243, 233, 0.18);
		background: rgba(248, 243, 233, 0.14);
	}

	.hero-strip span {
		display: grid;
		align-items: center;
		min-height: 58px;
		padding: 15px 16px;
		color: rgba(248, 243, 233, 0.88);
		background: rgba(16, 24, 21, 0.68);
		font-size: 0.84rem;
		font-weight: 760;
		text-align: center;
	}

	.intro,
	.services,
	.audience,
	.why,
	.process,
	.about,
	.contact {
		padding: clamp(70px, 10vw, 132px) clamp(20px, 6vw, 82px);
	}

	.intro,
	.about,
	.contact {
		display: grid;
		grid-template-columns: minmax(0, 1.02fr) minmax(300px, 0.98fr);
		gap: clamp(36px, 7vw, 96px);
		align-items: start;
	}

	.intro {
		background: #f5f2eb;
	}

	.intro-copy p:last-child,
	.about-panel p:last-child {
		margin-bottom: 0;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(300px, 1.1fr);
		gap: clamp(28px, 6vw, 82px);
		margin-bottom: 42px;
	}

	.section-heading.compact {
		margin-bottom: 30px;
	}

	.services {
		background: #e8eee9;
	}

	.service-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
	}

	.service-card {
		min-height: 280px;
		padding: 26px;
		border: 1px solid #ccd8d0;
		border-radius: 8px;
		background: #fbfaf5;
	}

	.service-card h3 {
		margin-bottom: 18px;
	}

	.service-card p {
		margin-bottom: 0;
	}

	.audience {
		background: #f5f2eb;
	}

	.audience-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 10px;
		padding: 0;
		margin: 0;
		list-style: none;
	}

	.audience-list li {
		min-height: 74px;
		padding: 18px;
		border: 1px solid #d2cab9;
		border-radius: 8px;
		color: #22312c;
		background: #fbfaf5;
		font-weight: 760;
	}

	.why {
		background: #dce7e0;
	}

	.reason-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 14px;
	}

	.reason-grid article {
		padding: 28px;
		border-left: 4px solid #0d6f6a;
		border-radius: 8px;
		background: #fbfaf5;
	}

	.reason-grid p {
		margin-bottom: 0;
	}

	.process {
		background: #f5f2eb;
	}

	.process-list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0;
		padding: 0;
		margin: 0;
		list-style: none;
		border-top: 1px solid #cfc7b6;
		border-left: 1px solid #cfc7b6;
	}

	.process-list li {
		display: grid;
		align-content: start;
		min-height: 250px;
		padding: 24px;
		border-right: 1px solid #cfc7b6;
		border-bottom: 1px solid #cfc7b6;
	}

	.process-list span {
		margin-bottom: 48px;
		color: #0d6f6a;
		font-size: 0.86rem;
		font-weight: 820;
	}

	.process-list strong {
		margin-bottom: 14px;
		color: #17201d;
		font-size: 1.25rem;
		line-height: 1.15;
	}

	.process-list p {
		margin-bottom: 0;
		font-size: 0.95rem;
		line-height: 1.58;
	}

	.about {
		background: #17201d;
	}

	.about h2 {
		color: #f8f3e9;
	}

	.about-panel {
		padding: 30px;
		border: 1px solid rgba(248, 243, 233, 0.16);
		border-radius: 8px;
		background: rgba(248, 243, 233, 0.08);
	}

	.about-panel p {
		color: rgba(248, 243, 233, 0.82);
	}

	.proof {
		padding: clamp(72px, 9vw, 118px) clamp(20px, 10vw, 140px);
		background: #0f1715;
	}

	.proof p {
		max-width: 1120px;
		margin: 0;
		color: #f8f3e9;
		font-size: clamp(1.8rem, 4.6vw, 4.8rem);
		line-height: 1.04;
	}

	.contact {
		background: #d9d0be;
	}

	.contact-panel {
		padding: 30px;
		border: 1px solid rgba(23, 32, 29, 0.16);
		border-radius: 8px;
		background: #f8f3e9;
	}

	.contact-panel p {
		margin-bottom: 24px;
	}

	.contact-panel .button {
		width: 100%;
	}

	@media (max-width: 1080px) {
		.hero-strip,
		.audience-list,
		.process-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.service-grid,
		.reason-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 860px) {
		.site-header {
			align-items: flex-start;
			padding: 16px 18px;
		}

		nav {
			flex-wrap: wrap;
			row-gap: 8px;
			max-width: 430px;
		}

		.hero {
			min-height: 90vh;
			padding-top: 132px;
		}

		.intro,
		.section-heading,
		.about,
		.contact {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 680px) {
		.site-header {
			position: absolute;
			gap: 14px;
		}

		.brand span:last-child {
			display: none;
		}

		nav {
			gap: 10px;
			font-size: 0.76rem;
		}

		.hero {
			min-height: 94vh;
			padding: 122px 18px 28px;
		}

		.hero-media img {
			object-position: 64% center;
		}

		.hero-media::after {
			background:
				linear-gradient(90deg, rgba(13, 21, 18, 0.94) 0%, rgba(13, 21, 18, 0.82) 70%, rgba(13, 21, 18, 0.48) 100%),
				linear-gradient(180deg, rgba(13, 21, 18, 0.18) 0%, rgba(13, 21, 18, 0.34) 58%, rgba(13, 21, 18, 0.88) 100%);
		}

		h1 {
			font-size: clamp(3rem, 15vw, 4.8rem);
		}

		h2 {
			font-size: clamp(2rem, 10vw, 3rem);
		}

		.hero-actions,
		.hero-actions .button {
			width: 100%;
		}

		.hero-strip,
		.service-grid,
		.audience-list,
		.reason-grid,
		.process-list {
			grid-template-columns: 1fr;
		}

		.hero-strip span {
			text-align: left;
		}

		.intro,
		.services,
		.audience,
		.why,
		.process,
		.about,
		.contact {
			padding: 66px 18px;
		}

		.service-card,
		.process-list li {
			min-height: auto;
		}

		.process-list span {
			margin-bottom: 34px;
		}

		.proof {
			padding: 64px 18px;
		}

		.about-panel,
		.contact-panel {
			padding: 22px;
		}
	}
</style>
